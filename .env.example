# agentloop — environment configuration
# Copy this file to .env and fill in the values you need.
# All settings are optional unless marked REQUIRED.
# Lists are JSON arrays: TOOL_BLOCKLIST=["rm","dd"]
# Secret values are never logged.

# ── LLM provider ──────────────────────────────────────────────────────────────
# Supported providers: mistral (default), openai, anthropic, ollama
# REQUIRED: set the API key for your chosen provider.
# MISTRAL_API_KEY=                      # Mistral API key (REQUIRED for mistral provider)
# LLM_PROVIDER=mistral                  # Provider name: mistral | openai | anthropic | ollama
# LLM_MODEL=mistral-large-latest        # Model identifier for the chosen provider
# LLM_TEMPERATURE=0.0                   # Sampling temperature (0.0 = deterministic)
# MAX_ITERATIONS=20                     # Max tool-call rounds before the agent stops
# MAX_TOKENS_BUDGET=4000                # Hard token cap enforced by PydanticAI UsageLimits
# MAX_CONTEXT_TOKENS=8000               # Context window size; used by trim_messages()
# LLM_RETRY_MAX=3                       # Number of retries on transient LLM API errors

# ── Tools ─────────────────────────────────────────────────────────────────────
# TOOL_TIMEOUT_MS=30000                 # Per-tool execution timeout in milliseconds
# AUTO_APPROVE_ALL=false                # Skip confirmation prompts for cautious/dangerous tools
# TOOL_ALLOWLIST=[]                     # Whitelist: only these tools are available (empty = all)
# TOOL_BLOCKLIST=[]                     # Blacklist: these tools are always blocked
# SHELL_COMMAND_BLOCKLIST=[]            # Shell sub-commands that are always blocked (e.g. ["rm -rf"])
# MAX_CONCURRENT_TOOLS=5                # Max tools running simultaneously (asyncio.Semaphore)

# ── Paths ─────────────────────────────────────────────────────────────────────
# WORKSPACE_ROOT=.                      # Root directory the agent may read/write (defaults to cwd)
# SYSTEM_PROMPT_PATH=                   # Path to a custom system prompt file (overrides default)
# SKILLS_DIR=                           # Extra directory of pydantic-ai-skills skill folders
# AGENT_PROFILES_DIR=                   # Extra directory of *.agent.json profile files

# ── Security ──────────────────────────────────────────────────────────────────
# MAX_FILE_SIZE_BYTES=5000000           # Files larger than this are refused (5 MB)
# MAX_SHELL_OUTPUT_BYTES=500000         # Shell output is truncated to this size (500 KB)
# NETWORK_ALLOWED_DOMAINS=[]            # Domain allowlist for outbound HTTP (empty = allow all)

# ── Web search ────────────────────────────────────────────────────────────────
# Supported providers: duckduckgo (default, no key needed), tavily, none
# WEB_SEARCH_PROVIDER=duckduckgo        # Search backend: duckduckgo | tavily | none
# TAVILY_API_KEY=                       # REQUIRED when WEB_SEARCH_PROVIDER=tavily
# DUCKDUCKGO_MAX_RESULTS=5              # Number of search results to return

# ── Web fetch ─────────────────────────────────────────────────────────────────
# WEB_DOMAIN_BLOCKLIST=[]              # Domains the web-fetch tool may never access
# WEB_DOMAIN_ALLOWLIST=[]              # Domains the web-fetch tool may access (empty = all)
# WEB_ALLOW_HTTP=false                  # Allow plain http:// URLs (https only by default)
# WEB_MAX_RESPONSE_BYTES=2000000        # Response body truncated to this size (2 MB)
# WEB_FETCH_TIMEOUT_MS=10000            # Fetch timeout in milliseconds

# ── Streaming ─────────────────────────────────────────────────────────────────
# STREAMING_ENABLED=false               # Stream tokens to the CLI as they arrive

# ── Observability ─────────────────────────────────────────────────────────────
# Primary: set LOGFIRE_TOKEN to enable Logfire (traces, token counts, costs).
# Fallback: set TRACING_ENABLED=true to write .jsonl trace files locally.
# LOGFIRE_TOKEN=                        # Logfire token (https://logfire.pydantic.dev)
# TRACING_ENABLED=false                 # Enable local FileTracer (.jsonl files)
# TRACE_OUTPUT_DIR=traces               # Directory for local trace files
# TRACING_COST_PER_INPUT_TOKEN_USD=0.0  # Cost rate for input tokens (used in cost reports)
# TRACING_COST_PER_OUTPUT_TOKEN_USD=0.0 # Cost rate for output tokens (used in cost reports)

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO                        # Log verbosity: DEBUG | INFO | WARNING | ERROR
# LOG_DESTINATION=stdout                # Log output: stdout | stderr

# ── MCP servers ───────────────────────────────────────────────────────────────
# JSON array of MCP server configs. Each object has:
#   name, transport ("stdio"|"sse"), command (stdio), args (stdio), url (sse)
# Example:
#   MCP_SERVERS=[{"name":"filesystem","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."]}]
# MCP_SERVERS=[]
